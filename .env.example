# Copy to .env in WSL. Replace credentials for your local PostgreSQL database.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://mastery:CHANGE_ME@localhost:5432/mastery_development
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
# Integration tests use a separate database; export this explicitly before pytest.
# TEST_DATABASE_URL=postgresql+psycopg://mastery:CHANGE_ME@localhost:5432/mastery_test
AUTH_MODE=development_identity
# Seed through mastery-content first; absence denies all admin requests.
# DEVELOPMENT_USER_ID=00000000-0000-0000-0000-000000000001
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ALLOWED_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=true
API_DOCS_ENABLED=true
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=262144
MAX_CODE_BYTES=65536
MAX_PAGE_SIZE=100

# Development only; admission requires a freshly authenticated, probed worker.
LOCAL_RUNNER_ENABLED=false

# Local publication only: approve the exact immutable policy from an inspected S012 report.
# Missing approval or usable report keeps publication at 503; restart the API after changes.
# PUBLICATION_EVALUATOR_POLICY_VERSION_ID=00000000-0000-0000-0000-000000000000
